<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64;x86</Platforms>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <CefSharpVersion Condition="'$(CefSharpVersion)' == ''">156.0.150</CefSharpVersion>
    <CefSharpPackageSuffix Condition="'$(CefSharpVersion)' == '84.4.10'">84</CefSharpPackageSuffix>
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(CefSharpVersion)', '130.0.0'))">$(DefineConstants);CEF_CORPUS_NEW_DOWNLOAD_RETURN</DefineConstants>
    <AssemblyName>MonkeySharp.PackageConsumer</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mzying2001.MonkeySharp.CefSharp$(CefSharpPackageSuffix).$(Platform)" Version="$(MonkeySharpPackageVersion)" />
    <PackageReference Include="CefSharp.WinForms" Version="[$(CefSharpVersion)]" />
  </ItemGroup>
</Project>
