<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64;x86</Platforms>
    <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == 'x86'">x86</PlatformTarget>
    <RootNamespace>Mzying2001.MonkeySharp.CefSharp.SmokeHost</RootNamespace>
    <AssemblyName>MonkeySharp.CefSharp.SmokeHost</AssemblyName>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <CefSharpVersion Condition="'$(CefSharpVersion)' == ''">121.3.70</CefSharpVersion>
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(CefSharpVersion)', '130.0.0'))">$(DefineConstants);CEF_CORPUS_NEW_DOWNLOAD_RETURN</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::VersionLessThan('$(CefSharpVersion)', '100.0.0'))">$(DefineConstants);CEF_SHARP_LEGACY_REQUEST_FACTORY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\scripts\compatibility\PackageConsumer\CorpusHost.cs" Link="CorpusHost.cs" />
    <PackageReference Include="CefSharp.WinForms" Version="$(CefSharpVersion)" />
    <Reference Include="System.Net.Http" />
    <EmbeddedResource Include="Fixtures\*.user.js" />
    <EmbeddedResource Include="Fixtures\loopback.pfx" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mzying2001.MonkeySharp.CefSharp\Mzying2001.MonkeySharp.CefSharp.csproj" />
  </ItemGroup>
</Project>
