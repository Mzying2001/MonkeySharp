<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Version.props" />
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Title>Mzying2001.MonkeySharp.CefSharp</Title>
    <AssemblyName>Mzying2001.MonkeySharp.CefSharp</AssemblyName>
    <RootNamespace>Mzying2001.MonkeySharp.CefSharp</RootNamespace>
    <PackageId>Mzying2001.MonkeySharp.CefSharp</PackageId>
    <Authors>Mzying2001</Authors>
    <Platforms>x64;x86</Platforms>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <CefSharpBuildAction>NoAction</CefSharpBuildAction>
    <!--
      CefSharp is selected by the host application. Keep a known-good default
      for deterministic repository builds, while allowing source consumers to
      compile the adapter against the exact CefSharp version they run.
      Example: dotnet build -p:Platform=x64 -p:CefSharpVersion=84.4.10
    -->
    <CefSharpVersion Condition="'$(CefSharpVersion)' == ''">156.0.150</CefSharpVersion>
    <CefSharpPackageSuffix Condition="'$(CefSharpVersion)' == '84.4.10'">84</CefSharpPackageSuffix>
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(CefSharpVersion)', '143.0.0'))">$(DefineConstants);CEF_SHARP_EXTENDED_RENDER_TERMINATED</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::VersionLessThan('$(CefSharpVersion)', '100.0.0'))">$(DefineConstants);CEF_SHARP_LEGACY_REQUEST_FACTORY</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
    <PackageId>Mzying2001.MonkeySharp.CefSharp$(CefSharpPackageSuffix).x64</PackageId>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x86'">
    <PlatformTarget>x86</PlatformTarget>
    <PackageId>Mzying2001.MonkeySharp.CefSharp$(CefSharpPackageSuffix).x86</PackageId>
  </PropertyGroup>
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RepositoryUrl>https://github.com/Mzying2001/MonkeySharp.git</RepositoryUrl>
    <Description>CefSharp $(CefSharpVersion) host adapter for MonkeySharp userscripts. Install the matching CefSharp UI package and process platform.</Description>
    <PackageProjectUrl>https://github.com/Mzying2001/MonkeySharp</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Js\Lifecycle.js" />
    <EmbeddedResource Include="Js\Isolated.js" />
    <EmbeddedResource Include="Js\LifecycleEvents.js" />
    <EmbeddedResource Include="Protocol\psl-*.dat.gz" LogicalName="Mzying2001.MonkeySharp.CefSharp.Protocol.%(Filename)%(Extension)" />
    <None Remove="Protocol\psl-*.dat.gz;Protocol\public-suffix-snapshots.json;Protocol\THIRD-PARTY-NOTICES.md" />
    <None Include="Protocol\psl-*.dat.gz;Protocol\public-suffix-snapshots.json;Protocol\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="third-party/public-suffix/" />
    <None Include="..\README.md">
      <Pack>true</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <!-- Pin the managed/native runtime to the version this binary targets.
         The host chooses the matching WinForms, WPF or OffScreen package. -->
    <PackageReference Include="CefSharp.Common" Version="[$(CefSharpVersion)]" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mzying2001.MonkeySharp.Core\Mzying2001.MonkeySharp.Core.csproj" />
  </ItemGroup>
  <Target Name="ValidatePackagePlatform" BeforeTargets="GenerateNuspec"
          Condition="'$(Platform)' != 'x64' and '$(Platform)' != 'x86'">
    <Error Text="Pack the CefSharp adapter with -p:Platform=x64 or -p:Platform=x86." />
  </Target>
</Project>
