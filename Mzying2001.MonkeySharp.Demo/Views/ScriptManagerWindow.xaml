<Window x:Class="Mzying2001.MonkeySharp.Demo.Views.ScriptManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonkeySharp · 脚本管理器" Width="1150" Height="780" MinWidth="900" MinHeight="600" Background="#F4F6F9">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="用户脚本" FontSize="26" FontWeight="SemiBold" Foreground="#172B40" Margin="0,0,0,10" />
        <Border DockPanel.Dock="Top" Background="#FFF4DB" Padding="10" Margin="0,0,0,10">
            <TextBlock x:Name="TrustWarning" TextWrapping="Wrap" Foreground="#704C0A" />
        </Border>
        <WrapPanel DockPanel.Dock="Top" IsEnabled="{Binding CanEdit}">
            <Button Content="新建" Command="{Binding NewCommand}" /><Button Content="导入文件" Click="ImportFile" />
            <Button Content="启用 / 停用" Command="{Binding ToggleCommand}" /><Button Content="删除" Command="{Binding DeleteCommand}" />
            <Button Content="验证元数据" Command="{Binding ValidateCommand}" /><Button Content="安装 / 保存" Command="{Binding SaveCommand}" />
        </WrapPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,8,0,12" IsEnabled="{Binding CanEdit}">
            <Button DockPanel.Dock="Right" Content="从 URL 加载草稿" Command="{Binding InstallUrlCommand}" />
            <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Padding="8" ToolTip="HTTP(S) .user.js 地址" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#334155" />
        <Grid IsEnabled="{Binding CanEdit}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="275" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <TextBox DockPanel.Dock="Top" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,8" ToolTip="搜索脚本名称" />
                <ListBox ItemsSource="{Binding FilteredScripts}" SelectedItem="{Binding SelectedScript}" DisplayMemberPath="DisplayName" />
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" />
            <TabControl Grid.Column="2">
                <TabItem Header="源码编辑器">
                    <TextBox Text="{Binding Editor.Source, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                             FontFamily="Consolas" FontSize="13" Padding="12" Background="#FBFDFF"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </TabItem>
                <TabItem Header="元数据 / 权限 / 诊断">
                    <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
