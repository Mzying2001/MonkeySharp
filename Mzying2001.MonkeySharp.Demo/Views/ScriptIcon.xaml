<UserControl x:Class="Mzying2001.MonkeySharp.Demo.Views.ScriptIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="40" Height="40">
    <Grid>
        <Border x:Name="Fallback" Background="#E8F0F7" CornerRadius="5">
            <TextBlock x:Name="FallbackTextBlock" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#315A7D" FontSize="16" FontWeight="SemiBold" />
        </Border>
        <Image x:Name="Icon" Stretch="Uniform" Visibility="Collapsed" ImageFailed="IconFailed" />
    </Grid>
</UserControl>
