<Window x:Class="Mzying2001.MonkeySharp.Demo.Views.PermissionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Mzying2001.MonkeySharp.Demo.Localization"
        Title="{loc:Text PermissionsTitle}" Width="650" Height="450" WindowStartupLocation="CenterOwner">
    <ScrollViewer>
        <StackPanel x:Name="EntriesPanel" Margin="18">
            <TextBlock Text="{loc:Text RememberedPermissions}" FontSize="18" FontWeight="SemiBold" />
        </StackPanel>
    </ScrollViewer>
</Window>
