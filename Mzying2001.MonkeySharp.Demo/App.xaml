<Application x:Class="Mzying2001.MonkeySharp.Demo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="ApplicationStartup">
    <Application.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Foreground" Value="#243B53" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#DCEBFA" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#3978B9" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToggleSwitchStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="ToolTip" Value="{Binding ToggleLabel}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid Width="38" Height="20" SnapsToDevicePixels="True">
                            <Border x:Name="Track" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" />
                            <Border x:Name="Thumb" Width="16" Height="16" HorizontalAlignment="Left" Margin="2"
                                    Background="#FFFFFF" BorderBrush="#B8C5D1" BorderThickness="1" CornerRadius="8" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#3978B9" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#3978B9" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="BorderBrush" Value="#2F659D" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#1D5E96" />
                                <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#3978B9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Background" Value="#EEF2F6" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#D5DDE5" />
                                <Setter TargetName="Thumb" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="Thumb" Property="BorderBrush" Value="#D5DDE5" />
                                <Setter Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HideWhenTextEmpty" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
